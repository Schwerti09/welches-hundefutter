# bella-app — Umgebungsvariablen
# Kopie als .env.local (lokal) bzw. in der Netlify-UI unter Site configuration →
# Environment variables (Produktion). Alle Werte sind Beispiele.
#
# Der Build laeuft auch OHNE die meisten davon: DB-Abfragen liefern dann [] und
# der LLM-Berater faellt auf deterministischen Text zurueck.

# ─────────────────────────────────────────────────────────────────────────────
# Datenbank (Neon Postgres)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/bella?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# KI-Berater (BELLA) — /api/advisor/chat
# GEMINI ist primaer, ANTHROPIC ist Fallback. Ohne beide: deterministischer Text.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Transaktionale E-Mail (Resend) — Preis-Wecker, Double-Opt-in, Magic-Link, Outcome-Checks
# Ohne RESEND_API_KEY: kein Versand, nur Log. EMAIL_FROM MUSS zur in Resend
# verifizierten (Sub-)Domain passen. Einrichtung: docs/runbooks/resend-setup.md
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="BELLA <bella@send.welches-hundefutter.today>"

# Kanonische Basis-URL (E-Mail-Links, Redirects, Absender-Kontext)
SITE_URL="https://welches-hundefutter.today"

# ─────────────────────────────────────────────────────────────────────────────
# Produkt-Feeds — komma-separierte Download-URLs. *_EXTRA wird angehaengt.
# Genutzt von scripts/parse-feeds.py + den Netlify Scheduled Functions.
# ─────────────────────────────────────────────────────────────────────────────
AWIN_FEED_URLS=""
AWIN_FEED_URLS_EXTRA=""
ADCELL_FEED_URLS=""
ADCELL_FEED_URLS_EXTRA=""

# Optional: lokaler Ordner fuer geparste Feeds (Default: scripts/)
FEED_DIR=""
# Optional: "true" = Import-Skripte laufen ohne DB-Schreibzugriff
DRY_RUN=""

# ─────────────────────────────────────────────────────────────────────────────
# Sonstiges
# ─────────────────────────────────────────────────────────────────────────────
INDEXNOW_KEY=""              # IndexNow-Ping (Bing/Yandex) nach Feed-Import
PEXELS_API_KEY=""            # Bild-Beschaffung fuer Tipps/Content (scripts/fetch-*-images)
OUTREACH_TOKEN=""            # Bearer-Token fuer /api/outreach/* (Admin)
PAGESPEED_API_KEY=""         # Optional: hoeheres Kontingent fuer netlify/functions/lighthouse-check.mts (Roadmap 6.2). Laeuft auch ohne.

# Optional: verteiltes Rate-Limit ueber Upstash Redis (Roadmap 1.3). Kostenloses
# Kontingent reicht. Ohne diese beiden Vars faellt src/lib/rate-limit.ts auf den
# In-Memory-Fallback zurueck (funktioniert, zaehlt aber nicht instanzuebergreifend).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Nur fuer scripts/db-restore-blobs.mjs (Notfall-Wiederherstellung aus den
# woechentlichen Blob-Backups, Roadmap 6.4). Der Backup-Job selbst
# (netlify/functions/db-backup.mts) braucht das NICHT — in einer Netlify Function
# ist der Blob-Context automatisch da.
NETLIFY_SITE_ID=""
NETLIFY_API_TOKEN=""
